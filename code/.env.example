# Copy to .env and fill in. .env is git-ignored.

# python/seadrift-data: mailbox that receives RockBLOCK delivery emails
SEADRIFT_EMAIL_USER=
SEADRIFT_EMAIL_PASSWORD=
# RockBLOCK device IMEI; only emails whose sender contains it are decoded
ROCKBLOCK_IMEI=
# Where decoded sensor values are written
SEADRIFT_OUTPUT_FILE=sea_drift_data.txt

# python/stable-diffusion
STABILITY_KEY=
