# Whitelist: only code/ and repo meta files are tracked.
# Media, documents, archives and _待刪除/ stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/code/

# Secrets
.env
.env.*
!.env.example
**/.vscode/sftp.json

# OS junk
.DS_Store
._*
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
tempCodeRunnerFile.py
